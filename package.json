{
  "name": "iconodb-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "IconoDB: app pessoal para consultar a base iconográfica e guardar a sua própria camada (notas, coleções, objetos, sítios, hipóteses e fotos), que sincroniza com o Dropbox.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "e2e": "playwright test",
    "icones": "node scripts/gerar-icones.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "dropbox": "10.47.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "topojson-client": "3.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1",
    "world-atlas": "2.0.2"
  }
}
